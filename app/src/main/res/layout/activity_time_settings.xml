<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kioskBgWindow">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingTop="16dp"
            android:paddingEnd="60dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_settings_title"
                android:textColor="?attr/kioskTitle"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="@string/time_settings_tip"
                android:textColor="?attr/kioskTextDim"
                android:textSize="13sp" />

            <include
                android:id="@+id/rowSingle"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowRest"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowDaily"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowGate"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowAuto"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowVoice"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowPreview"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowReset"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/rowDefault"
                layout="@layout/item_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/kioskPill"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="180dp"
                android:paddingStart="44dp"
                android:paddingTop="14dp"
                android:paddingEnd="44dp"
                android:paddingBottom="14dp"
                android:text="@string/back"
                android:textColor="?attr/kioskText"
                android:textSize="18sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
