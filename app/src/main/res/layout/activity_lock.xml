<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kioskBgWindow">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="?attr/kioskPanel"
        android:gravity="center"
        android:minWidth="560dp"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="44dp"
        android:paddingEnd="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="休息一下"
            android:textColor="?attr/kioskTitle"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bigText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="05:00"
            android:textColor="?attr/kioskAccent"
            android:textSize="92sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text=""
            android:textColor="?attr/kioskText"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:text="长按菜单键 2 秒，输入家长密码"
        android:textColor="?attr/kioskTextDim"
        android:textSize="14sp" />

</FrameLayout>
