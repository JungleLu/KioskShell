<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kioskBgWindow">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="?attr/kioskPanel"
        android:gravity="center"
        android:minWidth="560dp"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="30dp"
        android:paddingEnd="72dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="休息一下"
            android:textColor="?attr/kioskTitle"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bigText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="05:00"
            android:textColor="?attr/kioskAccent"
            android:textSize="92sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text=""
            android:textColor="?attr/kioskText"
            android:textSize="22sp" />

        <!--
          答题区。默认 GONE：家长没开这个功能时，这一页和原来一模一样。
          不新开 Activity 是有原因的 —— 看门狗每 8 秒会把这个页面重新拉起来一次，
          两个 Activity 会互相打架，返回栈也会乱。

          面板的内边距比原来紧（上下 30dp，原来是 44/48）：加上四宫格之后整块高度
          会顶到屏幕底部那行「长按菜单键或点左下角家长」上面去，压住字。
          实测 1080p 上省下的这 50dp 刚好让两行分开。
        -->
        <LinearLayout
            android:id="@+id/quizPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/quizTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/kioskTextDim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quizPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text=""
                android:textColor="?attr/kioskTitle"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opt0"
                    style="@style/QuizOption"
                    android:text="" />

                <TextView
                    android:id="@+id/opt1"
                    style="@style/QuizOption"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opt2"
                    style="@style/QuizOption"
                    android:text="" />

                <TextView
                    android:id="@+id/opt3"
                    style="@style/QuizOption"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/quizFoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text=""
                android:textColor="?attr/kioskTextDim"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:text="长按菜单键或点左下角「家长」，输入家长密码"
        android:textColor="?attr/kioskTextDim"
        android:textSize="14sp" />

    <!--
      家长入口：和首页同一个按钮。
      锁屏页如果没有这个，小米这类收不到菜单键的电视就彻底没救了 —— 孩子看到休息页，
      家长连提前结束都做不到。
    -->
    <TextView
        android:id="@+id/parentBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:background="?attr/kioskPill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="38dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="家长"
        android:textColor="?attr/kioskTextDim"
        android:textSize="13sp" />

</FrameLayout>
