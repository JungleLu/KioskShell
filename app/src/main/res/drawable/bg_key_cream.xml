<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顺序不能动：按下态要在焦点态前面，默认项放最后 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6FAE" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#E0457F" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFD6E7" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF6FAE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF0F6" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#F3C6D9" />
        </shape>
    </item>
</selector>
